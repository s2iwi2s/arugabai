# Copy this file to .env (gitignored) and fill in real values.
# Save with LF endings -- a CRLF .env puts a trailing \r INSIDE each value,
# which makes a valid token 401 as though it had expired.

# --- Upstream repos to materialize as worktrees -----------------------------
# One UPSTREAM_REPO_<NAME> per repo. NAME becomes the folder under worktrees/.
# Optional #<branch> fragment picks the branch to check out (default: main).
# UPSTREAM_REPO_MYPROJECT=https://github.com/org/repo
# UPSTREAM_REPO_OTHERPROJECT=https://github.com/org/other-repo#develop

# arugabai is a monorepo (backend/, frontend/, mobile-react-native/, mobile-kmm/,
# db/, deploy/, docs/ all in one repo) -- this clones the whole thing once; work
# on the backend specifically from worktrees/arugabai/main/backend/.
UPSTREAM_REPO_ARUGABAI=https://github.com/Arugabai/infra.git#main
UPSTREAM_REPO_ARUGABAI_STRATEGY=https://github.com/Arugabai/strategy.git#main
UPSTREAM_REPO_ARUGABAI_TECHSPEC=https://github.com/Arugabai/techspec.git#main
UPSTREAM_REPO_ARUGABAI_APP=https://github.com/Arugabai/app.git#main
UPSTREAM_REPO_ARUGABAI_AGENT=https://github.com/Arugabai/agent.git#main
UPSTREAM_REPO_ARUGABAI_API=https://github.com/Arugabai/api.git#main
UPSTREAM_REPO_ARUGABAI_SITE=https://github.com/Arugabai/site.git#main
UPSTREAM_REPO_ARUGABAI_DESIGN=https://github.com/Arugabai/design.git#main
UPSTREAM_REPO_ARUGABAI_CORPUS=https://github.com/Arugabai/corpus.git#main
UPSTREAM_REPO_ARUGABAI_MOBILE_PROTOTYPE=https://github.com/Arugabai/arugabai-mobile-prototype.git#main
UPSTREAM_REPO_ARUGABAI_ORG_DEFAULTS=https://github.com/Arugabai/.github.git#main

DEFAULT_BRANCH=main

# --- GitHub token ------------------------------------------------------------
# A fine-grained PAT scoped to just the repos above. Needs Contents: Read/Write
# to push branches, and Pull requests: Read/Write if Claude will open PRs via gh.
GITHUB_TOKEN=
